# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# `.env` is git-ignored; `.env.example` documents every variable the app reads.

# --- JWT signing secret (REQUIRED in production) ---
# A long random string. Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# --- Database ---
# SQLite (local default). Docker overrides this to sqlite:////data/linksnip.db.
DATABASE_URL=sqlite:///linksnip.db

# --- Google Safe Browsing Lookup API key (Malware/Phishing check) ---
# Optional. Empty disables the safe-browsing scan.
SAFE_BROWSING_API_KEY=

# --- SMTP (for password-reset & email-verification emails) ---
# Example values for Gmail SMTP (+ an app password, NOT your login password).
# If SMTP_HOST is empty, emails are logged instead of sent (development fallback).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=
SMTP_FROM=you@gmail.com
SMTP_STARTTLS=1

# --- Frontend base used to build reset/verify links in emails ---
FRONTEND_BASE=http://127.0.0.1:5174

# --- Email verification: addresses allowed to log in WITHOUT verifying (comma-sep) ---
# Empty = no exceptions (all users must verify their email).
ALLOW_UNVERIFIED_EMAILS=

# --- Rate limiting (per client IP, fixed window) ---
RATE_LIMIT_API_LIMIT=120
RATE_LIMIT_REDIRECT_LIMIT=600
RATE_LIMIT_WINDOW_SECONDS=60

# --- Short-link redirect status: 302 (default, counts clicks) or 301 (cacheable) ---
REDIRECT_STATUS=302